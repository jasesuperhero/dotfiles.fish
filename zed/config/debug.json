// Zed debugger scaffolds (DAP). Open the debug panel and pick a config, or
// bind a key to `debugger::Start`. Zed installs the adapter binaries on first
// use. Mirrors your old vscode debugpy / lldb-dap setup.
[
  // ─── Python (debugpy) ──────────────────────────────────────────────────────
  {
    "label": "Python: current file",
    "adapter": "Debugpy",
    "request": "launch",
    "program": "$ZED_FILE",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Python: pytest current file",
    "adapter": "Debugpy",
    "request": "launch",
    "module": "pytest",
    "args": ["$ZED_FILE", "-v"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },

  // ─── Native (CodeLLDB) — Swift / Rust / C. Build first, then point at the
  // produced binary. Adjust "program" to your executable. ──────────────────
  {
    "label": "LLDB: launch binary",
    "adapter": "CodeLLDB",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/.build/debug/your-binary",
    "cwd": "$ZED_WORKTREE_ROOT"
  }
]
